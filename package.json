{
  "name": "webidl2js",
  "version": "21.2.0",
  "description": "Auto-generates class structures for WebIDL specifications",
  "license": "MIT",
  "author": "Sebastian Mayr <npm@smayr.name>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsdom/webidl2js.git"
  },
  "files": [
    "lib/"
  ],
  "type": "commonjs",
  "main": "lib/transformer.js",
  "scripts": {
    "check": "npm run lint && npm run fmt:check",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "node --test test/*.js",
    "test:update-snapshots": "node --test --test-update-snapshots test/*.js"
  },
  "dependencies": {
    "oxfmt": "0.75.0",
    "webidl-conversions": "^8.0.1",
    "webidl2": "^24.5.0"
  },
  "devDependencies": {
    "@domenic/eslint-config": "^6.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  },
  "engines": {
    "node": "^22.14.0 || >=24.0.0"
  }
}
